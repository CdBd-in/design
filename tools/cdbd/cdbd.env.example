# ~/.config/cdbd/cdbd.env 예시 — 실제 값은 이 파일이 아니라 ~/.config/cdbd/cdbd.env 에 (chmod 600 · git 금지)
# 공용 CdBd 계정. 기기끼리 옮겨도 된다. (credentials.json은 복사 금지 — auth.py가 알아서 만든다)
CDBD_EMAIL=
CDBD_PASSWORD=
# 새 기기에서 credentials.json 없이 첫 발급할 때 필요 (Supabase 공개 anon 키 · 다른 기기의 cdbd.env에서 옮겨 온다)
CDBD_SUPABASE_URL=
CDBD_SUPABASE_ANON_KEY=
